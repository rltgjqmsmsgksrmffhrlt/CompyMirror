{
  "manifest_version": 3,
  "name": "CompyMirror",
  "version": "1.0.0",
  "description": "Your webcam as a mirror — with beauty filters, presets, and photo booth. 100% local, no server upload.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Open CompyMirror"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [],
  "web_accessible_resources": [
    {
      "resources": ["CompyMirror_v10.html"],
      "matches": []
    }
  ]
}
